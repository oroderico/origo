# Origo: original LILYGO TTGO T-Display (ESP32, 240x135)

# The seed tool is an offline appliance. UART remains available to the ROM
# bootloader for flashing, but the application exposes no console or protocol.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

CONFIG_APP_EXCLUDE_PROJECT_NAME_VAR=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_STACK_CHECK_MODE_STRONG=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y
CONFIG_ESP32_REV_MIN_1=y
CONFIG_ESP32_UNIVERSAL_MAC_ADDRESSES_TWO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
CONFIG_ESP_TASK_WDT_INIT=n

# No application persistence, networking, OTA or rollback state.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_PEM_PARSE_C=n
CONFIG_MBEDTLS_HAVE_TIME=n

CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTERS=3
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
